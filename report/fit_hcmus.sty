% 11. TRANG BÌA HIỆN ĐẠI DÀNH CHO BÁO CÁO ĐỒ ÁN (PROJECT COVER PAGE)
% ==============================================================================
\newcommand{\makecoverpage}{
    \begin{titlepage}
        \thispagestyle{empty}
        \begin{center}
            % Header cơ quan
            {\fontsize{13pt}{16pt}\selectfont \textbf{ĐẠI HỌC QUỐC GIA THÀNH PHỐ HỒ CHÍ MINH}}\\[4pt]
            {\fontsize{14pt}{17pt}\selectfont \textbf{\color{HCMUSBlue}TRƯỜNG ĐẠI HỌC KHOA HỌC TỰ NHIÊN}}\\[4pt]
            {\fontsize{13pt}{16pt}\selectfont \textbf{\color{FITBlue}KHOA CÔNG NGHỆ THÔNG TIN}}\\[8pt]
            
            % Đường line phân cách hiện đại
            {\color{FITBlue}\rule{0.65\textwidth}{1.5pt}}\\[18pt]

            % Biểu trưng Trường ĐH Khoa học Tự nhiên
            \vspace{5pt}
            {\centering\includegraphics[height=3.6cm]{figures/hcmus_logo.png}\par}
            \vspace{18pt}

            % Thông tin môn học & Loại báo cáo
            {\fontsize{13pt}{16pt}\selectfont \textbf{MÔN HỌC: \@courseid\ - \@coursename}}\\[6pt]
            {\fontsize{14pt}{18pt}\selectfont \textbf{\color{DarkNavy}\@reportsubtitle}}\\[20pt]

            % Tên đề tài lớn
            \begin{tcolorbox}[
                colback=white,
                colframe=HCMUSBlue,
                arc=4pt,
                boxrule=1.5pt,
                width=\textwidth,
                halign=center,
                top=12pt,
                bottom=12pt
            ]
                {\fontsize{18pt}{24pt}\bfseries\color{HCMUSBlue} \@title}
            \end{tcolorbox}
            \vspace{25pt}

            % Khung thông tin Giảng viên & Sinh viên
            \begin{flushleft}
            \hspace*{1.0cm}
            \begin{tabular}{ll}
                \textbf{\fontsize{13pt}{16pt}\selectfont Giảng viên hướng dẫn:} & \fontsize{13pt}{16pt}\selectfont \@instructor \\[6pt]
                \textbf{\fontsize{13pt}{16pt}\selectfont Lớp:} & \fontsize{13pt}{16pt}\selectfont \@classid \\[6pt]
                \textbf{\fontsize{13pt}{16pt}\selectfont Năm học:} & \fontsize{13pt}{16pt}\selectfont \@academicyear \\[6pt]
                \textbf{\fontsize{13pt}{16pt}\selectfont Sinh viên thực hiện:} & \\[4pt]
                \multicolumn{2}{l}{
                    \hspace*{0.5cm}
                    \begin{minipage}{0.85\textwidth}
                        \@author
                    \end{minipage}
                }
            \end{tabular}
            \end{flushleft}
            
        \end{center}
    \end{titlepage}
}

